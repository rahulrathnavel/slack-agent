NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Slack app credentials
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
SLACK_STATE_SECRET=change-me-to-a-long-random-string

# Optional for single-workspace local testing after OAuth install.
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=

# NVIDIA NIM/OpenAI-compatible API
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL_PRIMARY=mistralai/mistral-medium-3.5-128b
NVIDIA_MODEL_REASONING=moonshotai/kimi-k2.6
NVIDIA_MODEL_FAST=mistralai/mistral-medium-3.5-128b
NVIDIA_MODEL_SAFETY=nvidia/llama-3.1-nemotron-safety-guard-8b-v3

# Web and asset search
TAVILY_API_KEY=
OPENVERSE_BASE_URL=https://api.openverse.engineering/v1

# Storage
DATA_DIR=./data
PUBLIC_DIR=./public
